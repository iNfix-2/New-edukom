# Export these variables in your shell or configure them in your hosting panel.
# Use a stable, generated secret even for development to preserve sessions.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@edukom.ng
OFFICIAL_NOTIFICATION_EMAILS=info@edukom.ng
CONTACT_TO_EMAIL=info@edukom.ng
